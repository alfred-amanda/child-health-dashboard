    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@tailwindcss/postcss": "4.3.0",
    "autoprefixer": "10.5.0",
    "eslint": "10.4.1",
    "jsdom": "29.1.1",
    "postcss": "8.5.15",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.0",
